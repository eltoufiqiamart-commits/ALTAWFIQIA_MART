{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/app/admin/**",
    "src/components/admin/**",
    "src/lib/server/admin/**",
    "src/app/api/admin/**",
    "src/app/api/uploads/content/**"
  ]
}
